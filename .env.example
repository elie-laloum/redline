# Copier en `.env` et remplir. `.env` est gitignore depuis le premier commit.
# Les valeurs ne sortent jamais en clair dans le contexte d'un agent : seul
# `get-autopilot-env` les lit, et il ne rend que « presente » ou « absente ».

# --- Slack : jeton UTILISATEUR (xoxp-), pas un jeton de bot ---
# Toutes les actions apparaissent sous mon nom. Avec un jeton de bot, le canal
# serait cree par une app et l'effet « c'est l'utilisateur qui ecrit » tombe.
# Scopes (onglet « User Token Scopes ») :
#   groups:write  groups:write.invites  bookmarks:write  chat:write  users:read.email
SLACK_USER_TOKEN=
# Mon identifiant Slack, pour le DM de rapport.
SLACK_SELF_USER_ID=

# --- GitLab : jeton d'acces personnel ---
# Portees : api, write_repository
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=

# --- Jira : jeton d'API Atlassian ---
# L'API Jira Cloud s'authentifie en Basic (e-mail + jeton), pas en Bearer.
JIRA_SITE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Figma : jeton personnel, lecture seule ---
# Facultatif. Sans lui, les tools `get-figma-*` rendent une absence de maquette,
# et le run continue : beaucoup de tickets n'en ont pas.
FIGMA_TOKEN=

# --- Optionnel ---
# Racine de l'etat local. Par defaut ~/.autopilot
# AUTOPILOT_HOME=
