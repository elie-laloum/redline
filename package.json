{
  "name": "@elie-laloum/redline",
  "version": "3.1.0",
  "license": "MIT",
  "author": "Elie Laloum <pro@elielaloum.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/elie-laloum/redline.git"
  },
  "type": "module",
  "description": "Autonomous delivery from a Jira ticket: framing, adversarial TDD repo by repo, memory, publication.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "redline": "bun --no-env-file src/cli/main.ts",
    "test": "bun test --timeout 30000 tests/unit",
    "test:workflow": "bun test --timeout 600000 tests/workflow",
    "test:all": "bun run test && bun run test:workflow",
    "typecheck": "tsc --noEmit",
    "fixtures": "bun tests/fixtures/materialize.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@elie-laloum/outpost": "9.0.0",
    "@opentui/core": "0.5.14",
    "commander": "^15.0.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3"
  },
  "bin": {
    "redline": "src/cli/main.ts"
  },
  "files": [
    "src",
    "templates",
    "docker"
  ]
}
