{
  "name": "redline",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "author": "Elie Laloum <pro@elielaloum.com>",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/e.laloum/autopilot.git"
  },
  "type": "module",
  "description": "Autonomous delivery from a Jira ticket: framing, adversarial TDD repo by repo, memory, publication.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test --timeout 30000 tests/unit",
    "test:workflow": "bun test --timeout 600000 tests/workflow",
    "test:all": "bun run test && bun run test:workflow",
    "typecheck": "tsc --noEmit",
    "eval": "claude plugin eval ./plugins/autopilot --ablation with-without --mocks record --allow-real-servers --allow-tools 'mcp__plugin_autopilot_autopilot__*' --runs 3",
    "config:check": "bun plugins/autopilot/mcp/scripts/check-config.ts",
    "clear": "bun plugins/autopilot/mcp/scripts/clear-run.ts",
    "fixtures": "bun tests/fixtures/materialize.ts",
    "bench": "bun plugins/autopilot/mcp/scripts/bench-commands.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@elie-laloum/outpost": "9.0.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "commander": "^15.0.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3"
  }
}
