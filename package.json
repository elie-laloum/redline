{
  "name": "autopilot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Developpement autonome depuis un ticket Jira : cadrage, TDD adversarial repo par repo, capitalisation memoire, publication.",
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/unit/*.test.ts\"",
    "test:workflow": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/workflow/*.test.ts\"",
    "test:all": "pnpm test && pnpm test:workflow",
    "typecheck": "tsc --noEmit && pnpm --dir tools/live-shell typecheck",
    "eval": "claude plugin eval ./plugins/autopilot --ablation with-without --mocks record --allow-real-servers --allow-tools 'mcp__plugin_autopilot_autopilot__*' --runs 3",
    "live:dev": "pnpm --dir tools/live-shell dev",
    "live:build": "pnpm --dir tools/live-shell build",
    "config:check": "node plugins/autopilot/mcp/scripts/check-config.ts",
    "fixtures": "node tests/fixtures/materialize.ts",
    "bench": "node plugins/autopilot/mcp/scripts/bench-commands.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "valibot": "^1.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
